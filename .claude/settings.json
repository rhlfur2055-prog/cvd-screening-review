{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "uv run python .claude/hooks/guard_generated.py" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "uv run python .claude/hooks/verify_on_edit.py" }]
      }
    ]
  }
}
